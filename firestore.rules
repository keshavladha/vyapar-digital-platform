rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════ CLIENT ORDERS COLLECTION ═══════════════
    match /orders/{trackingId} {
      // Allow any visitor to create a valid booking order
      allow create: if request.resource.data.trackingId != null 
                    && request.resource.data.clientName is string
                    && request.resource.data.clientName.size() > 0
                    && request.resource.data.clientName.size() <= 100;
                    
      // Allow reading order details for tracking and dashboard
      allow read: if true;
      
      // Allow updating stage or adding revision notes
      allow update: if request.resource.data.trackingId == trackingId;
      
      // Deny deletion of business records
      allow delete: if false;
    }
    
    // ═══════════════ RATE CALCULATOR LEADS ═══════════════
    match /quotes/{quoteId} {
      // Allow saving calculated quotation leads
      allow create: if request.resource.data.businessType != null;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
